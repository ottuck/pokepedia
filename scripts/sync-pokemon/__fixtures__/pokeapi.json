    "flavor_text_entries": [
      {
        "flavor_text": "만들어 내는 전기가 강력한\n피카츄일수록 볼의 주머니가\n부드럽고 잘 늘어난다.",
        "language": {
          "name": "ko"
        },
        "version": {
          "name": "sword"
        }
      },
      {
        "flavor_text": "서로의 꼬리를 붙여서\n전기를 흐르게 하는 게\n피카츄 사이의 인사법이다.",
        "language": {
          "name": "ko"
        },
        "version": {
          "name": "shield"
        }
      },
      {
        "flavor_text": "When Pikachu meet, they’ll touch their tails\ntogether and exchange electricity through them\nas a form of greeting.",
        "language": {
          "name": "en"
        },
        "version": {
          "name": "shield"
        }
      },
      {
        "flavor_text": "Possesses cheek sacs in which it stores electricity. This clever\nforest-dweller roasts tough berries with an electric shock before\nconsuming them.",
        "language": {
          "name": "en"
        },
        "version": {
          "name": "legends-arceus"
        }
      },
      {
        "flavor_text": "つくる　電気が　強力な\nピカチュウほど　ほっぺの　袋は\n軟らかく　よく　伸びるぞ。",
        "language": {
          "name": "ja"
        },
        "version": {
          "name": "sword"
        }
      },
      {
        "flavor_text": "おたがいの　しっぽを　くっつけて\n電気を　流しあうのが\nピカチュウ　同士の　挨拶だ。",
        "language": {
          "name": "ja"
        },
        "version": {
          "name": "shield"
        }
      },
      {
        "flavor_text": "Plus la puissance électrique de Pikachu est élevée,\nplus les poches de ses joues sont extensibles.",
        "language": {
          "name": "fr"
        },
        "version": {
          "name": "sword"
        }
      },
      {
        "flavor_text": "Les Pikachu se disent bonjour en se frottant\nla queue et en y faisant passer du courant\nélectrique.",
        "language": {
          "name": "fr"
        },
        "version": {
          "name": "shield"
        }
      }
    ],
