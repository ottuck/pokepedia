      {
        "genus": "バリアーポケモン",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        }
      }
    ],
    "flavor_text_entries": [
      {
        "flavor_text": "커다란 손바닥은 팬터마임을\n하기 위해 발달했다고\n생각하는 학자도 많다.",
        "language": {
          "name": "ko"
        },
        "version": {
          "name": "sword"
        }
      },
      {
        "flavor_text": "팬터마임이 특기다. 손가락에서\n내보내는 파동으로 벽을 만들어\n갖은 공격으로부터 몸을 지킨다.",
        "language": {
          "name": "ko"
        },
        "version": {
          "name": "shield"
        }
      },
      {
        "flavor_text": "It’s known for its top-notch pantomime skills.\nIt protects itself from all sorts of attacks by\nemitting auras from its fingers to create walls.",
        "language": {
          "name": "en"
        },
        "version": {
          "name": "shield"
        }
      },
      {
        "flavor_text": "The behavior of this clown-like Pokémon reminds one of\npantomime. It creates invisible walls using a force emitted\nfrom its fingertips.",
        "language": {
          "name": "en"
        },
        "version": {
          "name": "legends-arceus"
        }
      },
      {
        "flavor_text": "大きな　手のひらは　パントマイムを\nするために　発達　したと\n考える　学者も　多い。",
        "language": {
          "name": "ja"
        },
        "version": {
          "name": "sword"
        }
      },
      {
        "flavor_text": "パントマイムが　得意。　指から\n出した　波動で　壁を　つくり\nあまたの　攻撃から　身を守る。",
        "language": {
          "name": "ja"
        },
        "version": {
          "name": "shield"
        }
      },
      {
        "flavor_text": "De nombreux savants pensent que ses mains\nse sont développées pour faire de la pantomime.",
        "language": {
          "name": "fr"
        },
        "version": {
          "name": "sword"
        }
      },
      {
        "flavor_text": "Son talent pour le mime est indéniable.\nIl émet des ondes du bout des doigts pour créer\nun mur qui le protège de nombreuses attaques.",
        "language": {
          "name": "fr"
        },
        "version": {
          "name": "shield"
        }
      }
    ],
