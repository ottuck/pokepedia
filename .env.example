# Copy to .env.local. Local development points at `pnpm supabase start`,
# not the remote project. Values are printed by `pnpm supabase status`.

# Browser + SSR (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_...

# Seed script only (scripts/sync-pokemon.ts). Not needed on Vercel.
# Changing it changes every silhouette key, so keep it stable per environment.
SILHOUETTE_SECRET=
